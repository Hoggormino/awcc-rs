[Unit]
Description=AWCC privileged hardware service
Documentation=https://github.com/Hoggormino/awcc-rs
After=multi-user.target

[Service]
Type=simple
ExecStart=/usr/bin/awcc-cli -d
Restart=on-failure
RestartSec=5
User=root
Group=root
# Creates /run/awcc for the control socket and removes it on stop.
RuntimeDirectory=awcc
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=no
# Session logs of the service go to /var/lib/awcc/awcc-rs/logs (bounded by the diagnostics sink).
StateDirectory=awcc
Environment=XDG_STATE_HOME=/var/lib/awcc
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes

[Install]
WantedBy=multi-user.target
